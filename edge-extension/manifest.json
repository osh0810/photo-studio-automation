{
  "manifest_version": 3,
  "name": "마음껏 예약 발송 연결",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "로그인된 일반 Edge에서 승인된 예약만 연결합니다.",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": ["https://partner.booking.naver.com/*", "https://partner.talk.naver.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "마음껏 예약 실행기"}
}
